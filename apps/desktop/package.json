{
  "name": "@tiendita/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "assemble": "node scripts/assemble.mjs",
    "pack": "pnpm build && pnpm assemble && electron-builder --dir",
    "dist": "pnpm build && pnpm assemble && electron-builder"
  },
  "build": {
    "appId": "mx.tiendita.pos",
    "productName": "Tiendita POS",
    "directories": { "output": "release" },
    "files": ["dist/**/*"],
    "extraResources": [
      { "from": "staging/web", "to": "web" },
      { "from": "staging/api", "to": "api" },
      { "from": "staging/pgsql", "to": "pgsql" }
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
