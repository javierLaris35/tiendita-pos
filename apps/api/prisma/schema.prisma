generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  cashier
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

enum ProductUnit {
  pz
  kg
}

/// Inventario real de la tienda.
model Product {
  id        Int         @id @default(autoincrement())
  barcode   String      @unique
  name      String
  brand     String?
  category  String?
  unit      ProductUnit @default(pz)
  price     Decimal     @db.Decimal(12, 2)
  cost      Decimal     @default(0) @db.Decimal(12, 2)
  stock     Decimal     @default(0) @db.Decimal(12, 3)
  ivaRate   Decimal     @default(0) @db.Decimal(5, 4)
  iepsRate  Decimal     @default(0) @db.Decimal(5, 4)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

/// Catálogo de referencia (precargado desde Open Food Facts o armado al escanear).
model CatalogItem {
  code     String  @id
  name     String
  brand    String?
  category String?
  image    String?
}
