generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  cashier
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

enum ProductUnit {
  pz
  kg
}

/// Inventario real de la tienda.
model Product {
  id        Int         @id @default(autoincrement())
  barcode   String      @unique
  name      String
  brand     String?
  category  String?
  unit      ProductUnit @default(pz)
  price     Decimal     @db.Decimal(12, 2)
  cost      Decimal     @default(0) @db.Decimal(12, 2)
  stock     Decimal     @default(0) @db.Decimal(12, 3)
  ivaRate         Decimal  @default(0) @db.Decimal(5, 4)
  iepsRate        Decimal  @default(0) @db.Decimal(5, 4)
  wholesalePrice  Decimal? @db.Decimal(12, 2)
  wholesaleMinQty Decimal? @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Catálogo de referencia (precargado desde Open Food Facts o armado al escanear).
model CatalogItem {
  code     String  @id
  name     String
  brand    String?
  category String?
  image    String?
}

enum PaymentMethod {
  cash
  card
  transfer
}

enum SaleStatus {
  completed
  returned
}

/// Ticket de venta.
model Sale {
  id          Int           @id @default(autoincrement())
  cashierId   Int
  createdAt   DateTime      @default(now())
  subtotal    Decimal       @db.Decimal(12, 2)
  taxTotal    Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  profitTotal Decimal       @db.Decimal(12, 2)
  change        Decimal       @default(0) @db.Decimal(12, 2)
  status        SaleStatus    @default(completed)
  cashSessionId Int?
  items         SaleItem[]
  payments      SalePayment[]
}

/// Línea de un ticket, con valores congelados al momento de la venta.
model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int
  barcode     String
  name        String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  ivaRate     Decimal @db.Decimal(5, 4)
  iepsRate    Decimal @db.Decimal(5, 4)
  lineTotal   Decimal @db.Decimal(12, 2)
  lineTax     Decimal @db.Decimal(12, 2)
  lineProfit  Decimal @db.Decimal(12, 2)
  usedWholesale Boolean @default(false)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  sale        Sale    @relation(fields: [saleId], references: [id])
}

/// Pago de un ticket (permite pago mixto: varios por venta).
model SalePayment {
  id     Int           @id @default(autoincrement())
  saleId Int
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)
  sale   Sale          @relation(fields: [saleId], references: [id])
}

enum MovementReason {
  sale
  return
  adjustment
  waste
  receipt
}

/// Rastro de auditoría: cada cambio de stock deja un movimiento con su motivo.
model InventoryMovement {
  id         Int            @id @default(autoincrement())
  productId  Int
  reason     MovementReason
  quantity   Decimal        @db.Decimal(12, 3)
  stockAfter Decimal        @db.Decimal(12, 3)
  userId     Int?
  saleId     Int?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([productId, createdAt])
}

enum CashMovementType {
  in
  out
}

enum CashSessionStatus {
  open
  closed
}

/// Turno de caja: fondo inicial, movimientos y arqueo al cierre.
model CashSession {
  id            Int               @id @default(autoincrement())
  cashierId     Int
  openedAt      DateTime          @default(now())
  openingAmount Decimal           @db.Decimal(12, 2)
  status        CashSessionStatus @default(open)
  closedAt      DateTime?
  expectedCash  Decimal?          @db.Decimal(12, 2)
  countedCash   Decimal?          @db.Decimal(12, 2)
  difference    Decimal?          @db.Decimal(12, 2)
  notes         String?
  movements     CashMovement[]
}

/// Entrada o retiro de efectivo dentro de un turno.
model CashMovement {
  id        Int              @id @default(autoincrement())
  sessionId Int
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String
  userId    Int?
  createdAt DateTime         @default(now())
  session   CashSession      @relation(fields: [sessionId], references: [id])
}
